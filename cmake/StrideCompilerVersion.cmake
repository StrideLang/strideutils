# Writes the header that identifies the compiler to the cache (see
# CacheManager::getCompilerCommitHash() and isExperimentalCompiler()).
#
# Runs at build time (cmake -P), so that edits made after configuring are
# seen. The header is only rewritten when its contents change, so that an
# unchanged compiler doesn't rebuild.
#
# Inputs:
#   SOURCE_DIRS  '|'-separated git work trees of the compiler's sources
#   OUTPUT       path of the header to write

string(REPLACE "|" ";" SOURCE_DIRS "${SOURCE_DIRS}")
set(commits "")
set(modified "")
foreach(dir IN LISTS SOURCE_DIRS)
  get_filename_component(name "${dir}" NAME)
  execute_process(
    COMMAND git rev-parse --short HEAD
    WORKING_DIRECTORY "${dir}"
    OUTPUT_VARIABLE commit
    OUTPUT_STRIP_TRAILING_WHITESPACE
    RESULT_VARIABLE result
    ERROR_QUIET
  )
  if(NOT result EQUAL 0 OR NOT commit)
    set(commit "unknown")
  endif()
  list(APPEND commits "${name}:${commit}")

  # Changes to tracked files make the compiler differ from its commits.
  # Untracked files don't take part in the build until a tracked file (a
  # CMakeLists.txt) names them.
  execute_process(
    COMMAND git status --porcelain --untracked-files=no
    WORKING_DIRECTORY "${dir}"
    OUTPUT_VARIABLE status
    OUTPUT_STRIP_TRAILING_WHITESPACE
    RESULT_VARIABLE result
    ERROR_QUIET
  )
  if(result EQUAL 0 AND status)
    list(APPEND modified "${name}")
  endif()
endforeach()

string(REPLACE ";" " " commits "${commits}")
string(REPLACE ";" " " modified "${modified}")
if(modified)
  set(experimental 1)
else()
  set(experimental 0)
endif()

set(contents "// Generated by StrideCompilerVersion.cmake. Do not edit.
#define STRIDE_GIT_COMMIT_HASH \"${commits}\"
// 1 when the compiler's sources have uncommitted changes
#define STRIDE_COMPILER_EXPERIMENTAL ${experimental}
#define STRIDE_COMPILER_MODIFIED_SOURCES \"${modified}\"
")

set(previous "")
if(EXISTS "${OUTPUT}")
  file(READ "${OUTPUT}" previous)
endif()
if(NOT previous STREQUAL contents)
  file(WRITE "${OUTPUT}" "${contents}")
endif()
