state MyState {}

transition MyTransition {}

type _MyExtendedSchema {
    inherits: [_StateType]
    typeName: "myExtendedState"
}

myExtendedState MyExtendedState {}

module JustABlock {}
state NestedState {
    blocks: [
        signal MySignal {}
    ]
}

