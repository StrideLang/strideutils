type _Literals {
    typeName: "literals"
    properties: [
		typeProperty {
			name: "realLiteral"
			allowedTypes: [_RealLiteral, _IntLiteral]
			default: none
			required: on
		}		
        typeProperty {
			name: "constrainedReal"
			allowedTypes: [
                constrainedReal {
                    minimum: 2.0
                    maximum: 20.0
                }
            ]
			default: none
			required: on
		}		
        typeProperty {
			name: "constrainedReal2"
			allowedTypes: [
                constrainedReal {
                    exclusiveMinimum: 2.1
                    exclusiveMaximum: 20.1
                }
            ]
			default: none
			required: on
		}
    ]
}

literals ValidReal {
    realLiteral: 4
    constrainedReal: 5
    constrainedReal2: 5
}

literals Real2 {
    realLiteral: 3.4
    constrainedReal: 2
    constrainedReal2: 3
}

literals Real3 {
    realLiteral: -3.1
    constrainedReal: 20
    constrainedReal2: 19
}

# Failures -----------------

literals Fails {
    realLiteral: on
    constrainedReal: 1.9
    constrainedReal2: 2.1
}

literals Fails2 {
    realLiteral: "string"
    constrainedReal: 21.3
    constrainedReal2: 20.1
}