type ObjType {
    typeName: "objType"
    properties: [	
        typeProperty {
			name: "port"
			types: [
                ObjType2
            ]
			default: none
			required: on
		}
    ]
}

type ObjType2 {
    typeName: "objType2"
    properties: [
    ]
}

type ObjType3 {
    typeName: "objType3"
    properties: [
    ]
}

objType2 Obj2 {}

objType Obj { port: Obj2 } # Valid
objType Obj_ { port: objType2 {} } # Valid
objType Obj_ { port: objType3 {} } # Invalid
objType Obj__ { port: 3 } # Invalid