type _Literals {
    typeName: "literals"
    properties: [
		typeProperty {
			name: "stringLiteral"
			allowedTypes: [_StringLiteral]
			default: none
			required: on
		}		
        typeProperty {
			name: "constrainedString"
			allowedTypes: [
                constrainedString {
                    minLength: 2
                    maxLength: 8
                }
            ]
			default: none
			required: on
		}
    ]
}

literals ValidString {
    stringLiteral: "hello"
    constrainedString: "wo"
}

literals ValidString {
    stringLiteral: "hello"
    constrainedString: "12345678"
}

# Failures -----------------

literals Fails {
    stringLiteral: 4
    constrainedString: "w"
}

literals Fails2 {
    stringLiteral: 4
    constrainedString: "123456789"
}
